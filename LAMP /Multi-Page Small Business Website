<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>Vertex Studio</title>
    <style>
        body { font-family: 'Segoe UI', sans-serif; margin: 0; background: #f4f6f8; color: #222; }
        header { background: #1e293b; color: #fff; padding: 16px 30px; display: flex; justify-content: space-between; align-items: center; }
        nav a { color: #fff; text-decoration: none; margin-left: 20px; font-weight: bold; cursor: pointer; }
        nav a:hover { color: #38bdf8; }
        .section { display: none; max-width: 800px; margin: 30px auto; background: #fff; padding: 24px; border-radius: 8px; box-shadow: 0 2px 8px rgba(0,0,0,0.08); }
        .section.active { display: block; }
        input, textarea { width: 100%; padding: 8px; margin: 8px 0 14px; border: 1px solid #ccc; border-radius: 4px; box-sizing: border-box; }
        button { background: #0284c7; color: #fff; padding: 10px 18px; border: none; border-radius: 4px; cursor: pointer; }
    </style>
</head>
<body>
    <header>
        <h2>Vertex Studio</h2>
        <nav>
            <a onclick="openPage('home')">Home</a>
            <a onclick="openPage('about')">About</a>
            <a onclick="openPage('contact')">Contact</a>
        </nav>
    </header>

    <div id="home" class="section active">
        <h1>Welcome to Vertex Studio</h1>
        <p>We craft clean websites and digital solutions for small businesses.</p>
    </div>

    <div id="about" class="section">
        <h1>About Us</h1>
        <p>Founded to deliver reliable web design, branding, and consulting with cohesive visual standards.</p>
    </div>

    <div id="contact" class="section">
        <h1>Contact Us</h1>
        <form onsubmit="event.preventDefault(); document.getElementById('sent').innerText='Message sent!';">
            <label>Name:</label><input type="text" required>
            <label>Email:</label><input type="email" required>
            <label>Message:</label><textarea rows="3" required></textarea>
            <button type="submit">Send</button>
        </form>
        <p id="sent" style="color:green; font-weight:bold;"></p>
    </div>

    <script>
        function openPage(id) {
            document.querySelectorAll(".section").forEach(s => s.classList.remove("active"));
            document.getElementById(id).classList.add("active");
        }
    </script>
</body>
</html>
