<?php
// LAMP / WAMP Stack Verification & MySQL Connection Script
$host = "localhost";
$user = "root";
$pass = "";
$dbname = "test_web_db";

$conn = new mysqli($host, $user, $pass);
if ($conn->connect_error) {
    die("Connection failed: " . $conn->connect_error);
}

$conn->query("CREATE DATABASE IF NOT EXISTS $dbname");
$conn->select_db($dbname);

$conn->query("CREATE TABLE IF NOT EXISTS users (
    id INT AUTO_INCREMENT PRIMARY KEY,
    username VARCHAR(50) NOT NULL,
    stack VARCHAR(10) NOT NULL
)");

if ($_SERVER["REQUEST_METHOD"] === "POST" && !empty($_POST["username"])) {
    $stmt = $conn->prepare("INSERT INTO users (username, stack) VALUES (?, ?)");
    $stmt->bind_param("ss", $_POST["username"], $_POST["stack"]);
    $stmt->execute();
    $stmt->close();
}

echo "<h3>Server: " . htmlspecialchars($_SERVER["SERVER_SOFTWARE"] ?? "Apache") . " | PHP: " . phpversion() . "</h3>";
echo "<form method='POST'>
    <input type='text' name='username' placeholder='Developer Name' required>
    <select name='stack'><option>LAMP</option><option>WAMP</option></select>
    <button type='submit'>Add</button>
</form>";

$result = $conn->query("SELECT * FROM users");
while ($row = $result->fetch_assoc()) {
    echo "<p>#{$row['id']} - " . htmlspecialchars($row['username']) . " ({$row['stack']})</p>";
}
$conn->close();
?>
